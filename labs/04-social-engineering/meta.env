# Metadata lab. Sengaja KEY=value, bukan YAML, biar bash 3.2 dan
# PowerShell 5.1 bisa baca tanpa modul tambahan apa pun.
ID=04
# Catatan penomoran: ID 04 itu urutan lab di kelas ini (Pertemuan 3 sesi 1),
# sedangkan MODUL 09 itu nomor modul Social Engineering di kurikulum CEH.
# Dua angka ini memang berbeda, dan yang dipakai di soal ujian adalah 09.
MODUL=09
MODUL_NAMA=Social Engineering
JUDUL=Social engineering, halaman umpan dan analisis header surel
DURASI=50
LEVEL=2
TIER=core
URL=http://localhost:8400
KREDENSIAL=rina.wulandari / KataSandiPalsu123 (palsu, cuma buat diketik ke halaman umpan)
TAGS=social-engineering,phishing,header-surel,indikator
CATATAN=Merek Tirtabyte fiktif, semua domain pakai TLD .example. Nol egress, nol sasaran manusia.
WAIT=1
# Lab ini terkurung total. Halaman umpan tidak boleh punya jalan keluar,
# titik. Baca _shared/compose.internet.yaml sebelum mengubah.
INTERNET=0
