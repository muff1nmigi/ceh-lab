# Metadata lab. Sengaja KEY=value, bukan YAML, biar bash 3.2 dan
# PowerShell 5.1 bisa baca tanpa modul tambahan apa pun.
ID=02
MODUL=13
MODUL_NAMA=Hacking Web Servers
JUDUL=Tomcat manager lemah dan Apache salah konfigurasi
DURASI=75
LEVEL=2
# core  = ditarik sama "./lab pull core", dipakai di jam kelas
# bonus = latihan mandiri, ditarik cuma sama "./lab pull all"
TIER=core
URL=http://localhost:8200/manager/html
KREDENSIAL=tidak diberikan, mencarinya bagian dari latihan
TAGS=webserver,tomcat,apache,hydra,webshell,enumerasi
CATATAN=Target kedua ada di http://localhost:8201. Dua-duanya multiarch, nol emulasi.
# WAIT=0 kalau lab ini punya layanan yang sengaja jalan sekali lalu mati
WAIT=1
# Lab ini terkurung total. Baca _shared/compose.internet.yaml sebelum mengubah.
INTERNET=0
