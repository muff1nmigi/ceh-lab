# Metadata lab. Sengaja KEY=value, bukan YAML, biar bash 3.2 dan
# PowerShell 5.1 bisa baca tanpa modul tambahan apa pun.
ID=05
MODUL=14
MODUL_NAMA=Hacking Web Applications
JUDUL=Meretas aplikasi web, dari SQL Injection sampai file upload
DURASI=90
LEVEL=2
# core  = ditarik sama "./lab pull core", dipakai di jam kelas
# bonus = latihan mandiri, ditarik cuma sama "./lab pull all"
TIER=core
URL=http://localhost:8500
KREDENSIAL=admin / password
TAGS=web,sqli,xss,command-injection,upload,bac,owasp
CATATAN=Sesi Rabu ke-2. Porsi SQL Injection paling besar karena SQL Injection modul tersendiri di exam tapi ga punya sesi sendiri di jadwal. Juice Shop di port 8501 buat peserta yang selesai duluan.
# WAIT=0 kalau lab ini punya layanan yang sengaja jalan sekali lalu mati
WAIT=1
# Lab ini terkurung total. Baca _shared/compose.internet.yaml sebelum mengubah.
INTERNET=0
