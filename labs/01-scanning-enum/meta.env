# Metadata lab. Sengaja KEY=value, bukan YAML, biar bash 3.2 dan
# PowerShell 5.1 bisa baca tanpa modul tambahan apa pun.
ID=01
MODUL=03
MODUL_NAMA=Scanning Networks dan Enumeration
JUDUL=Network scanning dan enumeration di jaringan target kecil
DURASI=75
LEVEL=2
# core  = ditarik sama "./lab pull core", dipakai di jam kelas
# bonus = latihan mandiri, ditarik cuma sama "./lab pull all"
TIER=core
URL=http://localhost:8180
KREDENSIAL=SSH budi / Password123 di localhost port 8122. SMB dan FTP dikerjakan dari toolbox.
TAGS=scanning,enumeration,nmap,smb,ftp,ssh,nse,footprinting
CATATAN=Empat target dalam satu jaringan internal. Semua image native arm64 dan amd64, nol emulasi. nmap -O sengaja tidak dipakai, alasannya di README.
# WAIT=0 kalau lab ini punya layanan yang sengaja jalan sekali lalu mati
WAIT=1
# INTERNET=1 cuma buat lab yang bahan latihannya memang ada di luar sana
# (sejauh ini cuma OSINT). Nilai selain 1 berarti lab terkurung total: nol
# jalan ke internet, nol jalan ke jaringan kelas. Kalau diisi 1, README lab
# ini WAJIB punya bagian berjudul "## Kenapa lab ini butuh internet", dan CI
# yang ngecek. Baca _shared/compose.internet.yaml sebelum ngisi 1.
INTERNET=0
