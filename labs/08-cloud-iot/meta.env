# Metadata lab. Sengaja KEY=value, bukan YAML, biar bash 3.2 dan
# PowerShell 5.1 bisa baca tanpa modul tambahan apa pun.
ID=08
MODUL=18+19
MODUL_NAMA=IoT and OT Hacking plus Cloud Computing
JUDUL=Audit akun AWS yang salah konfigurasi, lalu enumerasi PLC Modbus
DURASI=90
LEVEL=3
# core  = ditarik sama "./lab pull core", dipakai di jam kelas
# bonus = latihan mandiri, ditarik cuma sama "./lab pull all"
TIER=core
URL=http://localhost:8800/_localstack/health
KREDENSIAL=
TAGS=cloud,aws,s3,iam,sts,secretsmanager,bucket-terbuka,kredensial-hardcode,iot,ot,ics,scada,modbus,plc
CATATAN=Dua target. cloud di 8800 itu LocalStack 4.9 community, plc di 8802 itu Modbus TCP port 502. Pakai curl dan python3, toolbox sengaja tidak punya AWS CLI. Localstack tidak menegakkan IAM, jadi yang diaudit konfigurasinya, bukan penolakan aksesnya. Baca bagian batas di README.
WAIT=1
# Lab ini terkurung total. Baca _shared/compose.internet.yaml sebelum mengubah.
INTERNET=0
